# Cradlepoint R980
ROUTER_HOST=192.168.0.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=changeme
ROUTER_VERIFY_SSL=false

# Netgear GS105Ev2
SWITCH_HOST=192.168.0.2
SWITCH_PASSWORD=password

# LlamaFarm endpoint (Universal Runtime)
LLAMAFARM_ENDPOINT=http://localhost:11540/v1

# Router model (after fine-tuning, set to ft:YOUR_JOB_ID)
ROUTER_MODEL=unsloth/functiongemma-270m-it-GGUF

# Training data teacher model (for generate_training_data.py)
# Use a capable model for quality synthetic data
TEACHER_MODEL=unsloth/Qwen3-1.7B-GGUF
